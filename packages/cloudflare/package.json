{
  "name": "@effectivity/cloudflare",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.config.json",
    "test": "vitest run && vitest run --config vitest.config.node.ts",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "seed": "bash ./scripts/seed.sh",
    "cms": "effectivity"
  },
  "dependencies": {
    "@effectivity/api": "workspace:*",
    "@effectivity/auth": "workspace:*",
    "@effectivity/cli": "workspace:*",
    "@effectivity/core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "@types/bun": "catalog:"
  }
}
